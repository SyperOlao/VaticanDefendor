# Подключение к PostgreSQL.
# Непустой URL имеет приоритет над отдельными VD_AUTH_DB_* ниже.
# Спецсимволы в логине/пароле URL должны быть percent-encoded.
VD_AUTH_DATABASE_URL=

# Используются, если VD_AUTH_DATABASE_URL пустой.
# Пользователь и база должны существовать до запуска миграций.
VD_AUTH_DB_HOST=127.0.0.1
VD_AUTH_DB_PORT=5432
VD_AUTH_DB_NAME=vatican_auth
VD_AUTH_DB_USER=auth
VD_AUTH_DB_PASSWORD='replace-with-a-generated-password'
VD_AUTH_DB_POOL_SIZE=10

# HTTP-порт при запуске через python -m vatican_auth.
# В Docker внешний порт задаётся VD_AUTH_HOST_PORT в ../infra/.env.
VD_AUTH_PORT=8080

# Internal gRPC token introspection. Enabled automatically in the main Compose.
# Native startup requires the same VD_SERVICE_SECRET as rating (32..512 ASCII characters).
VD_AUTH_GRPC_ENABLED=false
VD_AUTH_GRPC_BIND=0.0.0.0:50051
VD_SERVICE_SECRET=
# Optional TLS certificate/key pair (PEM); configure both or neither.
VD_AUTH_GRPC_CERT_FILE=
VD_AUTH_GRPC_KEY_FILE=

# Сроки действия токенов в секундах: 15 минут / 30 дней / 30 дней.
VD_AUTH_ACCESS_TTL_SECONDS=900
VD_AUTH_REFRESH_TTL_SECONDS=2592000
VD_AUTH_GUEST_TTL_SECONDS=2592000

# Окно ограничения попыток в секундах и максимальное число попыток.
VD_AUTH_ATTEMPT_WINDOW_SECONDS=300
VD_AUTH_IP_ATTEMPT_LIMIT=60
VD_AUTH_LOGIN_ATTEMPT_LIMIT=10

# Политика паролей: длина в символах и число параллельных операций хэширования.
VD_AUTH_PASSWORD_MIN_LENGTH=8
VD_AUTH_PASSWORD_MAX_LENGTH=128
VD_AUTH_PASSWORD_CONCURRENCY=2

# Отдельная тестовая PostgreSQL-база; оставьте пустым, если тесты БД не запускаются.
# Тестовому пользователю нужны права CREATE/DROP SCHEMA в этой базе.
VD_TEST_AUTH_DATABASE_URL=
