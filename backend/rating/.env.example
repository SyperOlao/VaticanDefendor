# Export these variables before running Python; the service does not load .env automatically.
VD_RATING_DATABASE_URL=postgresql://rating:replace-with-db-password@127.0.0.1:5437/vatican_rating
# Use the same secret as game_backend, at least 32 characters.
VD_SERVICE_SECRET=
# Auth gRPC listener, not the public HTTP API. No HTTP fallback.
VD_AUTH_GRPC_TARGET=127.0.0.1:50051
VD_AUTH_GRPC_TIMEOUT_MS=2000
VD_AUTH_GRPC_ATTEMPTS=3
# Optional PEM CA certificate: enables TLS and verifies the server hostname.
VD_AUTH_GRPC_CA_FILE=
# API-only PostgreSQL budgets. Migrations do not inherit these limits.
VD_RATING_DB_POOL_SIZE=10
VD_RATING_DB_LOCK_TIMEOUT_MS=1000
VD_RATING_DB_STATEMENT_TIMEOUT_MS=5000
# Required only by the RabbitMQ worker; URL includes encoded credentials and vhost.
VD_RATING_RABBITMQ_URL=amqp://rating:replace-with-broker-password@127.0.0.1:5673/vatican
VD_RATING_RABBIT_QUEUE_PREFIX=vatican.rating
VD_RATING_RABBIT_EXCHANGE_PREFIX=vatican
