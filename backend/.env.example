# Generate real values outside Git with scripts/start-local.ps1.
VD_DATABASE_URL=postgresql://vatican:<database-password>@127.0.0.1:5432/vatican
VD_SERVER_POOL_JSON='[{"serverId":"<uuid>","host":"127.0.0.1","port":7979,"secret":"<at-least-32-random-characters>"}]'
VD_GRANT_TTL_SECONDS=120
# Supply a product-approved amount per church level for each deployed ContentRelease.
VD_RUN_REWARDS_JSON='{"sha256-<release-id>":{"perChurchLevel":<approved-amount>}}'
# Dedicated Unity server process policy; deployment values, not player-supplied data.
VD_SESSION_GRACE_SECONDS=10
VD_SESSION_AFTER_GRACE=pause
VD_SESSION_RETENTION_SECONDS=300
VD_SESSION_ON_EXPIRY=abandon
# Real-time interval between durable checkpoint publications (1..3600 seconds).
VD_CHECKPOINT_SECONDS=30
# Online backend (do not commit a populated .env).
VD_DB_POOL_SIZE=10
VD_SHOP_CATALOG_FILE=shop-catalog.json
# Optional deployment-only credential. Required to publish content, never shipped to clients.
VD_CONTENT_ADMIN_SECRET=<at-least-32-random-characters>
VD_API_HOST=<api-dns-hostname>
# Remote slot example: transport=dtls, certificateName matches the game server certificate.
# VD_SERVER_POOL_JSON='[{"serverId":"<uuid>","host":"<public-ipv4>","port":7979,"secret":"<random-secret>","transport":"dtls","certificateName":"<game-dns-hostname>"}]'
# Dedicated server: -vdDtls -vdBind 0.0.0.0
VD_DTLS_CERT_FILE=<server-certificate-chain.pem>
VD_DTLS_KEY_FILE=<server-private-key.pem>
# Desktop client override; mobile clients use the public CA in NetworkDeployment.asset.
VD_DTLS_CA_FILE=<trusted-ca.pem>
# Optional dedicated-server release fetched from backend, instead of the bundled release.
VD_CONTENT_RELEASE_ID=sha256-<published-release-id>
