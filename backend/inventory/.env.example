VD_INVENTORY_DATABASE_URL=postgresql://inventory:password@127.0.0.1:5435/vatican_inventory
VD_SERVICE_SECRET=replace-with-your-shared-service-secret
VD_AUTH_URL=http://127.0.0.1:8081
VD_GAME_URL=http://127.0.0.1:8080
VD_PORT=8083
VD_INVENTORY_GRPC_BIND=0.0.0.0:50051
# For TLS: VD_INVENTORY_GRPC_CERT_FILE and VD_INVENTORY_GRPC_KEY_FILE.
# Set this only for the RabbitMQ worker/producer CLI; URL-encode user/password/vhost.
VD_INVENTORY_RABBITMQ_URL=amqp://inventory:password@127.0.0.1:5673/vatican

# Dedicated TEST-only payment grants; see ../shop/MOCK_PAYMENTS.ru.md.
VD_APP_ENVIRONMENT=production
VD_INVENTORY_MOCK_PAYMENTS_ENABLED=0
# Same TEST grant key as shop, distinct from VD_SERVICE_SECRET (32..256 characters).
VD_MOCK_GRANT_SECRET=

# Межсервисная проверка доступа / команды кошельку. HTTP выбирается только явно.
VD_AUTH_TRANSPORT=grpc
VD_AUTH_GRPC_TARGET=127.0.0.1:50051
VD_AUTH_GRPC_TIMEOUT_MS=2000
VD_AUTH_GRPC_ATTEMPTS=3
VD_AUTH_GRPC_CA_FILE=
