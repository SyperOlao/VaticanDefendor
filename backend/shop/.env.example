VD_SHOP_DATABASE_URL=postgresql://shop:replace-with-a-local-password@127.0.0.1:5436/vatican_shop
VD_SERVICE_SECRET=replace-with-the-same-secret-in-participating-services
VD_AUTH_URL=http://127.0.0.1:8081
VD_GAME_URL=http://127.0.0.1:8080
VD_WALLET_URL=http://127.0.0.1:8082
VD_INVENTORY_URL=http://127.0.0.1:8083
VD_PORT=8084
VD_SHOP_S3_ENDPOINT_URL=http://127.0.0.1:19002
VD_SHOP_S3_BUCKET=vatican-shop-media
VD_SHOP_S3_ACCESS_KEY=vatican-shop-local
VD_SHOP_S3_SECRET_KEY=replace-with-the-value-from-infra-env
VD_SHOP_S3_REGION=us-east-1
VD_SHOP_MEDIA_BASE_URL=http://127.0.0.1:19002/vatican-shop-media

VD_ANALYTICS_URL=http://127.0.0.1:8086

# http (default) or rabbitmq; charge/refund still use wallet HTTP.
VD_SHOP_INVENTORY_TRANSPORT=rabbitmq
VD_INVENTORY_READ_TRANSPORT=grpc
VD_INVENTORY_GRPC_TARGET=127.0.0.1:28093
# Used only in rabbitmq mode. Alternatively set shared VD_RABBITMQ_* variables.
VD_SHOP_RABBITMQ_URL=amqp://inventory:replace-with-a-local-password@127.0.0.1:5673/vatican
VD_INVENTORY_RABBIT_QUEUE_PREFIX=vatican.inventory
VD_INVENTORY_RABBIT_EXCHANGE_PREFIX=vatican

# MOCK payments are absent by default. Enable only in an isolated TEST/dev deployment.
VD_APP_ENVIRONMENT=production
VD_SHOP_MOCK_PAYMENTS_ENABLED=0
# Set four distinct, randomly generated TEST secrets (32..256 characters each).
# They must also differ from VD_SERVICE_SECRET; never reuse production credentials.
VD_MOCK_CONTROL_SECRET=
VD_MOCK_WEBHOOK_SECRET=
VD_MOCK_RECEIPT_SECRET=
VD_MOCK_GRANT_SECRET=

# Межсервисная проверка доступа / команды кошельку. HTTP выбирается только явно.
VD_AUTH_TRANSPORT=grpc
VD_AUTH_GRPC_TARGET=127.0.0.1:50051
VD_AUTH_GRPC_TIMEOUT_MS=2000
VD_AUTH_GRPC_ATTEMPTS=3
VD_AUTH_GRPC_CA_FILE=
VD_WALLET_TRANSPORT=rabbitmq
VD_WALLET_GRPC_TARGET=127.0.0.1:50052
VD_WALLET_GRPC_CA_FILE=
VD_WALLET_RABBIT_QUEUE_PREFIX=vatican.wallet
VD_WALLET_RABBIT_EXCHANGE_PREFIX=vatican
