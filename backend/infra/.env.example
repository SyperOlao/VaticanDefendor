# Настройки общего Docker Compose. База и пользователь auth создаются автоматически.
# Укажите собственный пароль; отдельный URL подключения Compose собирает внутри сервиса.
VD_AUTH_DB_PASSWORD='replace-with-a-generated-password'

# Внешний HTTP-порт на 127.0.0.1. Внутри контейнера auth слушает 8080.
VD_AUTH_HOST_PORT=28081
VD_AUTH_DB_POOL_SIZE=10

# Сроки действия токенов в секундах.
VD_AUTH_ACCESS_TTL_SECONDS=900
VD_AUTH_REFRESH_TTL_SECONDS=2592000
VD_AUTH_GUEST_TTL_SECONDS=2592000

# Ограничение числа попыток по IP и логину за заданное окно в секундах.
VD_AUTH_ATTEMPT_WINDOW_SECONDS=300
VD_AUTH_IP_ATTEMPT_LIMIT=60
VD_AUTH_LOGIN_ATTEMPT_LIMIT=10

# Длина пароля в символах и число параллельных операций хэширования.
VD_AUTH_PASSWORD_MIN_LENGTH=8
VD_AUTH_PASSWORD_MAX_LENGTH=128
VD_AUTH_PASSWORD_CONCURRENCY=2

# Отдельная PostgreSQL для игровых данных (сервис postgres).
VD_POSTGRES_DB=vatican_game
VD_POSTGRES_USER=game
VD_POSTGRES_PASSWORD='replace-with-a-separate-game-database-password'
VD_POSTGRES_HOST_PORT=28432

# Доступ к PostgreSQL auth с локального компьютера.
VD_AUTH_DB_HOST_PORT=28433

# ClickHouse для аналитики: HTTP и native-протокол.
VD_CLICKHOUSE_DB=vatican_analytics
VD_CLICKHOUSE_USER=analytics
VD_CLICKHOUSE_PASSWORD='replace-with-a-separate-clickhouse-password'
VD_CLICKHOUSE_HTTP_HOST_PORT=28123
VD_CLICKHOUSE_NATIVE_HOST_PORT=28902

# Additional isolated services
VD_SERVICE_SECRET=replace-with-a-long-random-secret
VD_WALLET_DB_PASSWORD=replace-with-a-long-random-secret
VD_INVENTORY_DB_PASSWORD=replace-with-a-long-random-secret
VD_SHOP_DB_PASSWORD=replace-with-a-long-random-secret
VD_SHOP_S3_ACCESS_KEY=vatican-shop-local
VD_SHOP_S3_SECRET_KEY=replace-with-a-separate-random-secret
VD_SHOP_S3_BUCKET=vatican-shop-media
VD_SHOP_S3_HOST_PORT=28900
VD_SHOP_S3_CONSOLE_PORT=28901
# Optional public media URL override (otherwise derived from S3 host port/bucket).
# VD_SHOP_MEDIA_BASE_URL=https://media.example.com/vatican-shop-media
VD_RATING_DB_PASSWORD=replace-with-a-long-random-secret
VD_RATING_DB_POOL_SIZE=10
VD_RATING_DB_LOCK_TIMEOUT_MS=1000
VD_RATING_DB_STATEMENT_TIMEOUT_MS=5000
# Total time budget and maximum attempts for rating -> auth gRPC introspection.
VD_AUTH_GRPC_TIMEOUT_MS=2000
VD_AUTH_GRPC_ATTEMPTS=3

VD_PRESTIGE_RULESET_ID=
# Empty selects the example local ruleset when up.sh starts a Dedicated Server.
VD_ENERGY_RULESET_ID=
VD_ASSIGNMENT_LEASE_SECONDS=30
# Host-native Dedicated Server settings used by up.sh.
VD_LOCAL_SERVER_PORT=7979
# VD_UNITY_EDITOR=/absolute/path/to/Unity
# Set a prebuilt executable only to bypass automatic Unity builds.
# VD_LOCAL_SERVER_EXECUTABLE=/absolute/path/to/dedicated-server

# Default rating board receives server-calculated XP per run.
VD_RATING_BOARD_CODE=run-xp
VD_RATING_TRANSPORT=rabbitmq
VD_RATING_RABBIT_QUEUE_PREFIX=vatican.rating
VD_RATING_RABBIT_EXCHANGE_PREFIX=vatican

# Private durable analytics inbox; separate from ClickHouse and game data.
VD_ANALYTICS_INBOX_DB_PASSWORD=replace-with-a-separate-random-password
VD_ANALYTICS_HOST_PORT=28086
VD_ANALYTICS_INBOX_DB_HOST_PORT=28438

# RabbitMQ command transport for inventory (separate credentials and durable volume).
VD_RABBITMQ_USER=inventory
VD_RABBITMQ_PASSWORD=replace-with-a-separate-random-rabbit-password
VD_RABBITMQ_VHOST=vatican
VD_RABBITMQ_HOST_PORT=28672
VD_RABBITMQ_MANAGEMENT_PORT=28673
VD_SHOP_INVENTORY_TRANSPORT=rabbitmq
VD_GAME_INVENTORY_TRANSPORT=rabbitmq
VD_INVENTORY_READ_TRANSPORT=grpc
VD_INVENTORY_GRPC_TARGET=inventory_grpc:50051
VD_INVENTORY_GRPC_HOST_PORT=28093
VD_INVENTORY_RABBIT_QUEUE_PREFIX=vatican.inventory
VD_INVENTORY_RABBIT_EXCHANGE_PREFIX=vatican

# Local Superset / BI. Keep these values stable across restarts.
VD_SUPERSET_HOST_PORT=28088
VD_SUPERSET_SECRET_KEY=replace-with-a-separate-random-secret-at-least-42-characters
VD_SUPERSET_METADATA_DB_PASSWORD=replace-with-a-separate-metadata-password
VD_SUPERSET_ADMIN_USERNAME=admin
VD_SUPERSET_ADMIN_PASSWORD=replace-with-a-separate-admin-password
VD_SUPERSET_ADMIN_EMAIL=admin@vatican.local
VD_SUPERSET_BI_DATABASE=vatican_bi
VD_SUPERSET_CLICKHOUSE_USER=vatican_superset
VD_SUPERSET_CLICKHOUSE_PASSWORD=replace-with-a-separate-readonly-password

# Local Docker project and published ports.
COMPOSE_PROJECT_NAME=vatican-defendor
VD_DATA_NAMESPACE=vatican-defendor
# true only when ALL named volumes already exist (e.g. an installation migrated to a new project name).
VD_DATA_EXTERNAL=false
VD_GAME_HOST_PORT=28080
VD_WALLET_HOST_PORT=28082
VD_INVENTORY_HOST_PORT=28083
VD_SHOP_HOST_PORT=28084
VD_RATING_HOST_PORT=28085
VD_GATEWAY_HOST_PORT=28087
VD_WALLET_DB_HOST_PORT=28434
VD_INVENTORY_DB_HOST_PORT=28435
VD_SHOP_DB_HOST_PORT=28436
VD_RATING_DB_HOST_PORT=28437

# Межсервисная проверка доступа / команды кошельку. HTTP выбирается только явно.
VD_AUTH_TRANSPORT=grpc
VD_AUTH_GRPC_TARGET=auth:50051
VD_AUTH_GRPC_CA_FILE=
VD_WALLET_TRANSPORT=rabbitmq
VD_WALLET_GRPC_TARGET=wallet_grpc:50052
VD_WALLET_GRPC_CA_FILE=
VD_WALLET_RABBIT_QUEUE_PREFIX=vatican.wallet
VD_WALLET_RABBIT_EXCHANGE_PREFIX=vatican
