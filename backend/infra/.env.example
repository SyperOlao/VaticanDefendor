# Настройки общего Docker Compose. База и пользователь auth создаются автоматически.
# Укажите собственный пароль; отдельный URL подключения Compose собирает внутри сервиса.
VD_AUTH_DB_PASSWORD='replace-with-a-generated-password'

# Внешний HTTP-порт на 127.0.0.1. Внутри контейнера auth слушает 8080.
VD_AUTH_HOST_PORT=8081
VD_AUTH_DB_POOL_SIZE=10

# Сроки действия токенов в секундах.
VD_AUTH_ACCESS_TTL_SECONDS=900
VD_AUTH_REFRESH_TTL_SECONDS=2592000
VD_AUTH_GUEST_TTL_SECONDS=2592000

# Ограничение числа попыток по IP и логину за заданное окно в секундах.
VD_AUTH_ATTEMPT_WINDOW_SECONDS=300
VD_AUTH_IP_ATTEMPT_LIMIT=60
VD_AUTH_LOGIN_ATTEMPT_LIMIT=10

# Длина пароля в символах и число параллельных операций хэширования.
VD_AUTH_PASSWORD_MIN_LENGTH=8
VD_AUTH_PASSWORD_MAX_LENGTH=128
VD_AUTH_PASSWORD_CONCURRENCY=2
