
# Межсервисная проверка доступа / команды кошельку. HTTP выбирается только явно.
VD_AUTH_TRANSPORT=grpc
VD_AUTH_GRPC_TARGET=127.0.0.1:50051
VD_AUTH_GRPC_TIMEOUT_MS=2000
VD_AUTH_GRPC_ATTEMPTS=3
VD_AUTH_GRPC_CA_FILE=
VD_WALLET_DB_HOST=127.0.0.1
VD_WALLET_DB_PORT=28434
VD_WALLET_DB_NAME=vatican_wallet
VD_WALLET_DB_USER=wallet
VD_WALLET_DB_PASSWORD=replace-with-a-separate-password
VD_SERVICE_SECRET=replace-with-at-least-32-visible-ascii-characters
VD_RABBITMQ_HOST=127.0.0.1
VD_RABBITMQ_PORT=5672
VD_RABBITMQ_USER=inventory
VD_RABBITMQ_PASSWORD=replace-with-broker-password
VD_RABBITMQ_VHOST=vatican
VD_WALLET_GRPC_BIND=0.0.0.0:50052
